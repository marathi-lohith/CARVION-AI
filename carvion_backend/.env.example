# Django Core Settings
SECRET_KEY=django-insecure-replace-this-with-a-secure-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB Configuration (MongoEngine)
MONGODB_URI=mongodb://localhost:27017/carvion_db
MONGODB_DB=carvion_db

# Security & CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECURE_SSL_REDIRECT=False

# JWT Secrets and Expirations
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-in-production
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7

# Generative AI & NLP Integration
GEMINI_API_KEY=your_gemini_api_key_here

# Third Party APIs
RAPIDAPI_KEY=your_rapidapi_jsearch_key_here
YOUTUBE_API_KEY=your_youtube_data_api_key_here
